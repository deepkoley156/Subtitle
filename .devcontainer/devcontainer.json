{
  "name": "Subtitle Generator",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bullseye",
  "updateContentCommand": "pip install --upgrade pip && pip install -r requirements.txt",
  "postStartCommand": "python subtitle_generator_v2.py &",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python"
      ]
    }
  },
  "portsAttributes": {
    "5002": {
      "label": "Subtitle App",
      "onAutoForward": "openBrowser"
    }
  },
  "forwardPorts": [5002]
}
